{
  "name": "group6-ecosystems",
  "private": true,
  "type": "module",
  "description": "Build tools for the Group 6 Evergreen Coniferous Forest & Estuarine Zone static site",
  "scripts": {
    "build": "node tools/build.mjs",
    "charts": "node tools/build-charts.mjs",
    "maps": "node tools/build-maps.mjs",
    "serve": "python3 -m http.server 8080 --directory site",
    "qa": "python3 tools/qa/check_links.py && python3 tools/qa/content_check.py",
    "qa:a11y": "node tools/qa/axe.mjs"
  },
  "devDependencies": {
    "d3-geo": "^3.1.2",
    "d3-geo-projection": "^4.0.0",
    "mapshaper": "^0.6.121"
  }
}
